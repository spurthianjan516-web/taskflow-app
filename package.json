{
  "name": "taskflow-app",
  "version": "1.0.0",
  "description": "Task management service with full CI/CD pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --forceExit",
    "lint": "eslint src/ --ext .js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "test-results/coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "verbose": true,
    "silent": false
  }
}
